# ---------------------------------------------------------------------------
# SmartGreenAI: Cilantro Crop — environment configuration
# Copy to .env and adjust. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# --- Server ---
NODE_ENV=development
PORT=3000
APP_VERSION=1.0.0

# --- Database (PostgreSQL 15 / Supabase) ---
# Local docker:   postgresql://smartgreen:smartgreen@localhost:5432/smartgreen
# Supabase:       postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://smartgreen:smartgreen@localhost:5432/smartgreen
# Set to "require" when the provider needs TLS (Supabase, Render, Railway).
PGSSLMODE=disable

# --- Security (NFR-03, NFR-09) ---
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production-use-a-long-random-string
# Fallback session length in hours; the live value comes from security_settings.
JWT_EXPIRES_HOURS=8

# --- Background jobs ---
# Set to "false" to run the API without the automation/AI engines (used by tests).
JOBS_ENABLED=true

# --- Optional LLM rewording of AI explanations (US-21) ---
# Without a key the system always falls back to the deterministic template.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- IoT simulator / scripts ---
API_BASE_URL=http://localhost:3000/api
# Development API key for device dev-node-01 (see database/README.md).
DEVICE_API_KEY=sec_iot_dev_node_01_smartgreen_team3
