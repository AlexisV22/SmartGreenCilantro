#pragma once

#define WIFI_SSID      "your-wifi"
#define WIFI_PASSWORD  "your-wifi-password"

// Base URL of the API, without a trailing slash. Use HTTPS in production (NFR-09).
#define API_BASE_URL   "https://your-server.example.com/api"

// Plain API key shown ONCE when the device was registered (Administrator > IoT devices).
// Development key of dev-node-01 from database/seed.sql:
#define DEVICE_API_KEY "sec_iot_dev_node_01_smartgreen_team3"

// Optional: root CA certificate of your server (PEM) to validate HTTPS.
// Without it the firmware uses setInsecure(), acceptable only for development.
// #define API_ROOT_CA "-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----\n"
